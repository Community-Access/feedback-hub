# Copy to .env on the server and fill in. .env is gitignored; this file is the
# only copy that is committed and must never carry a real secret.

# ---------------------------------------------------------------- required --

# The public URL, exactly as people will type it, https included. FreeScout
# builds every absolute link and every password-reset URL from this, so a
# mismatch does not fail loudly -- it sends people to the wrong host in an
# email they cannot un-receive.
SITE_URL=https://helpdesk.community-access.org

# The first administrator. Created once, on the first boot only; changing these
# afterwards does nothing, because the account already exists.
ADMIN_EMAIL=
ADMIN_PASS=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# Database. Long and random -- nothing types these.
MARIADB_ROOT_PASSWORD=
DB_PASS=

# ---------------------------------------------------------------- optional --

# APPLICATION_NAME=Community Access Support
# TIMEZONE=America/Los_Angeles

# ------------------------------------------------------------------- email --
#
# Left blank on purpose at first deployment. FreeScout runs perfectly well with
# no mail configured -- agents can log in, look around, and learn the interface
# -- and wiring outbound before the sending domain is verified only produces
# bounces that teach Postmark to distrust the domain.
#
# Outbound is configured in the FreeScout web interface (Manage > Settings >
# Mail), not here, so that rotating the Postmark token never needs a container
# restart. Settings, from the plan:
#
#   Driver:     SMTP
#   Host:       smtp.postmarkapp.com
#   Port:       587
#   Encryption: TLS
#   Username:   <Postmark Server API token>
#   Password:   <the same token>
#   From:       support@community-access.org
#
# Inbound does NOT use IMAP against a hosted mailbox: Postmark has none.
# Postmark posts the raw RFC-822 message to the bridge, the bridge writes it to
# a local Maildir, and FreeScout fetches it over IMAP from localhost. See
# README.md, "Inbound".

# ------------------------------------------------------- inbound mail bridge --
#
# Postmark posts each inbound message to the bridge, which writes it into a
# Maildir that Dovecot exposes and FreeScout fetches. Generate every value
# below with `./make-credentials.sh`; none of them is ever typed by a person.

# HTTP Basic credentials Postmark presents. Postmark does not sign its inbound
# webhooks, so these are the whole of the authentication -- make them long.
# The bridge refuses every request when they are unset, rather than running
# open, so a missing value fails loudly instead of quietly serving the world.
MAILBRIDGE_WEBHOOK_USER=
MAILBRIDGE_WEBHOOK_PASSWORD=

# Optional. Postmark's published source addresses, comma-separated. Leave empty
# until you have checked the current list -- an out-of-date allowlist rejects
# real mail, and the bridge answers 401 rather than 403 for exactly that
# reason, so Postmark keeps retrying while somebody notices.
MAILBRIDGE_TRUSTED_IPS=

# Optional overrides; the defaults are in docker-compose.yml.
# MAILBRIDGE_RECIPIENTS=support@community-access.org
# MAILBRIDGE_PATH=/postmark/inbound

# The local IMAP account FreeScout signs in to. Not a person's account and
# never reused anywhere: it reaches one mailbox on a private Docker network.
# Written to deploy/helpdesk/dovecot-users by make-credentials.sh.
IMAP_USER=freescout-support
IMAP_PASSWORD=
