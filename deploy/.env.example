# Copy to deploy/.env on the server and fill in the token. deploy/.env is
# gitignored; this file is the only copy that is committed, and it must never
# be given a real value.

# Required. A GitHub fine-grained personal access token, scoped to the single
# target repository, with **Issues: read and write** and nothing else.
#
# Nothing else. Not contents, not actions, not metadata beyond what Issues
# implies. This process accepts anonymous input from the public internet; the
# worst an abused endpoint can then do is file issues, which is a bad afternoon
# rather than an incident.
FEEDBACK_HUB_GITHUB_TOKEN=

# Optional -- every one of these has a working default. Set one only to change
# it from what deploy/docker-compose.yml already shows.

# PICKS_REPO=Community-Access/quill
# PICKS_LABEL=pick:suggestion
# PICKS_PATH=/submit/picks
# PICKS_ALLOWED_ORIGINS=https://quillforall.org
# PICKS_PER_MINUTE=1
# PICKS_PER_DAY=20

# Optional spam challenge. Leave empty unless the endpoint is actually being
# abused; when set, every submission must carry a valid Turnstile token.
#
# Turnstile, never reCAPTCHA. Turnstile is usually invisible and needs no
# puzzle. reCAPTCHA's image grids are precisely the barrier this project exists
# to remove -- a spam control that locks out blind users to keep out bots has
# failed at the only job that matters here.
# TURNSTILE_SECRET=
